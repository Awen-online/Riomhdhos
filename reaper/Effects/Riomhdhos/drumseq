desc:Riomhdhos drum sequencer (8 voices x 8 steps, free-running)
// Sits FIRST on the DRUMS track, ahead of the instrument, and generates the notes it
// feeds. Nothing upstream sends it anything.
//
// ⚠️ WHY THE NOTES ARE GENERATED HERE AND NOT IN THE BRAIN
// The original plan put the drums on MIDI channel 5, sent from the brain like the four
// moods. That cannot work: `minilab-brain` re-channels EVERY note it sees to the active
// mood -
//     (st==0x90 || st==0x80) -> midisend(0x90|mood, ...)
// - so drum notes routed through CTRL would be hijacked onto whichever mood happened to
// be selected, and would change instrument every time the mood changed. Generating them
// on this track puts them downstream of the brain entirely. No channel arithmetic, and
// nothing to re-litigate when the mood switches.
//
// The pattern crosses tracks through gmem, the same way faders, layer mutes and view
// state already do - the Push writes it, this reads it.
//
// ⚠️ THE CLOCK IS FREE-RUNNING, NOT REAPER'S TRANSPORT
// The project timeline has media items on it, so rolling the transport to drive a
// sequencer would play them. This counts its own samples against the project tempo
// instead, so the rig can be rhythmic while the timeline stays parked. It also means
// the sequencer keeps time with nothing armed, nothing recording and no risk of
// nudging the edit cursor mid-set.

options:gmem=riomhdhos

slider1:0<0,1,1{stopped,RUNNING}>Transport
slider2:36<0,96,1>Voice 1 note (voices ascend from here)
slider3:100<1,127,1>Velocity
slider4:50<5,100,1>Gate length (% of a step)
slider5:2<0,7,1{1/4,1/4T,1/8,1/8T,1/16,1/16T,1/32,1/32T}>Step division
// COMPILE CANARY - a JSFX that fails to compile still reports its full parameter list
// through the API, so this is the only way to tell "loaded" from "running".
slider6:0<0,99,1>-alive
slider7:0<0,7,1>-current step

@init
slider6 = 1; sliderchange(slider6);

PAT  = 2000;   // gmem[PAT + voice*8 + step]  - 1 = step on
STEP = 2100;   // gmem[STEP]  current step, for the LEDs
RUN  = 2101;   // gmem[RUN]   1 = running
DIV  = 2102;   // gmem[DIV]   step division index

pos      = 0;    // samples into the current step
curstep  = 0;
gateleft = -1;   // samples until the note-offs are due; -1 = nothing sounding
lastrun  = -1;

// Note-offs are deferred rather than sent immediately after the note-on, so a voice
// gets a real gate rather than a zero-length blip. Which notes are sounding has to be
// remembered, because the pattern can be edited between the on and the off.
sounding = 3000;

function stepsamples() local(d, mul) (
  d = gmem[DIV] | 0;
  // even index = straight, odd = triplet. 1/4 = one beat.
  mul = d == 0 ? 1.0    : d == 1 ? (2/3)   :
        d == 2 ? 0.5    : d == 3 ? (1/3)   :
        d == 4 ? 0.25   : d == 5 ? (1/6)   :
        d == 6 ? 0.125  : (1/12);
  max(64, (srate * 60 / max(20, tempo)) * mul);
);

function allnotesoff() local(v) (
  v = 0;
  loop(8,
    sounding[v] ? ( midisend(0, 0x80, slider2 + v, 0); sounding[v] = 0; );
    v += 1;
  );
);

@slider
gmem[RUN] = slider1;
gmem[DIV] = slider5;

@block
// The Push owns both of these; mirror them onto the sliders so the state is legible in
// REAPER itself. Any state that can start or stop the rig must be visible without the
// controller - a controller can be unplugged, asleep or broken, and the pattern is not.
slider1 != gmem[RUN] ? ( slider1 = gmem[RUN]; sliderchange(slider1); );
slider5 != gmem[DIV] ? ( slider5 = gmem[DIV]; sliderchange(slider5); );

running = gmem[RUN] > 0.5;

// stopping must silence whatever is mid-gate, or a drum tail hangs until the next start
running != lastrun ? (
  !running ? ( allnotesoff(); gateleft = -1; );
  running  ? ( pos = 0; curstep = 0; );      // always restart from step 1
  lastrun = running;
);

running ? (
  spl = stepsamples();

  // close any gate that fell due during this block
  gateleft >= 0 ? (
    gateleft -= samplesblock;
    gateleft <= 0 ? ( allnotesoff(); gateleft = -1; );
  );

  pos += samplesblock;
  pos >= spl ? (
    pos -= spl;
    // a division change can leave pos far past the boundary; do not fire twice
    pos >= spl ? pos = 0;

    curstep = (curstep + 1) % 8;
    gmem[STEP] = curstep;
    slider7 = curstep; sliderchange(slider7);

    // anything still sounding is cut at the step edge rather than overlapping
    allnotesoff();

    v = 0;
    loop(8,
      gmem[PAT + v*8 + curstep] > 0.5 ? (
        midisend(0, 0x90, slider2 + v, slider3);
        sounding[v] = 1;
      );
      v += 1;
    );
    gateleft = spl * slider4 * 0.01;
  );
) : (
  gmem[STEP] = -1;    // no playhead when stopped, so the LEDs show the pattern alone
);
